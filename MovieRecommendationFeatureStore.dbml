// ============================================================
// HW2: Movie Recommendation (MovieLens 100K) - ER diagram, 3NF
// Cardinality notation: ">" = many-to-one, "-" = one-to-one
// ============================================================

// ---------------- 1. BUSINESS LAYER (source of truth) ----------------

Table hw2_occupations {
  occupation_id   smallint [pk, increment]
  occupation_name varchar(50) [not null, unique, note: 'e.g. student, engineer']
  Note: 'Occupation lookup table. Extracted from users to avoid repeating text values (3NF).'
}

Table hw2_users {
  user_id       int         [pk, note: 'u.user from MovieLens 100K']
  age           smallint    [not null]
  gender        char(1)     [not null, note: 'M / F']
  zip_code      varchar(10) [not null]
  occupation_id smallint    [not null, note: 'FK -> hw2_occupations']
  Note: 'Users. Each user must have exactly one occupation.'
}

Table hw2_genres {
  genre_id   smallint    [pk, increment]
  genre_name varchar(30) [not null, unique, note: 'Action, Comedy, Drama ... (19 genres)']
  Note: 'Genre lookup table (replaces the 19 boolean columns of u.item - removes repeating groups).'
}

Table hw2_movies {
  movie_id     int          [pk, note: 'item id from MovieLens']
  title        varchar(255) [not null]
  release_date date
  imdb_url     varchar(512)
  Note: 'Movies.'
}

// Natural N:M relationship  movies <-> genres
Table hw2_movie_genres {
  movie_id int [not null, note: 'FK -> hw2_movies']
  genre_id smallint [not null, note: 'FK -> hw2_genres']
  indexes {
    (movie_id, genre_id) [pk]
  }
  Note: 'Bridge table for N:M: a movie has >=1 genre, a genre belongs to many movies.'
}

// Natural N:M relationship  users <-> movies (timestamped interaction)
Table hw2_ratings {
  user_id  int       [not null, note: 'FK -> hw2_users']
  movie_id int       [not null, note: 'FK -> hw2_movies']
  rating   smallint  [not null, note: '1..5']
  rated_at timestamp [not null, note: 'u.data timestamp (UTC)']
  indexes {
    (user_id, movie_id) [pk]
    rated_at
  }
  Note: 'Bridge table for N:M users <-> movies. Interaction attributes: rating, rated_at.'
}

// ---------------- 2. OFFLINE FEATURE STORE ----------------

Table hw2_offline_user_features_hist {
  user_id           int       [not null, note: 'FK -> hw2_users']
  valid_from        timestamp [not null, note: 'start of validity of the feature values (inclusive)']
  valid_to          timestamp [note: 'end of validity (exclusive); NULL = current version']
  user_rating_count int       [not null, note: 'number of user ratings as of valid_from']
  user_avg_rating   float     [note: 'average rating as of valid_from (NULL if no ratings yet)']
  computed_at       timestamp [not null, note: 'when the row was computed (audit)']
  indexes {
    (user_id, valid_from) [pk]
  }
  Note: 'SCD2 history of user features. Features use only ratings with rated_at < valid_from.'
}

Table hw2_offline_movie_features_hist {
  movie_id           int       [not null, note: 'FK -> hw2_movies']
  valid_from         timestamp [not null]
  valid_to           timestamp [note: 'NULL = current version']
  movie_rating_count int       [not null, note: 'popularity as of valid_from']
  movie_avg_rating   float     [note: 'average movie rating as of valid_from']
  computed_at        timestamp [not null]
  indexes {
    (movie_id, valid_from) [pk]
  }
  Note: 'SCD2 history of movie features.'
}

Table hw2_training_events {
  event_id      bigint    [pk, increment]
  user_id       int       [not null, note: 'part of FK -> hw2_ratings']
  movie_id      int       [not null, note: 'part of FK -> hw2_ratings']
  prediction_ts timestamp [not null, note: 'moment the prediction is made; features are taken AS OF this time']
  target_liked  boolean   [not null, note: 'target: rating >= 4']
  dataset_split varchar(10) [not null, note: 'train / valid / test (time-based)']
  indexes {
    (user_id, movie_id) [unique]
    prediction_ts
  }
  Note: 'Training events. One row per rating. prediction_ts <= rated_at. Features are joined on: valid_from <= prediction_ts AND (valid_to IS NULL OR prediction_ts < valid_to).'
}

// ---------------- 3. ONLINE FEATURE STORE ----------------

Table hw2_online_user_features {
  user_id           int       [pk, note: 'FK -> hw2_users (one row per user)']
  user_rating_count int       [not null]
  user_avg_rating   float
  source_valid_from timestamp [not null, note: 'offline history version this row was materialized from']
  updated_at        timestamp [not null, note: 'when the online record was last updated']
  Note: 'CURRENT values only (key-value store for low-latency serving).'
}

Table hw2_online_movie_features {
  movie_id           int       [pk, note: 'FK -> hw2_movies (one row per movie)']
  movie_rating_count int       [not null]
  movie_avg_rating   float
  source_valid_from  timestamp [not null]
  updated_at         timestamp [not null]
  Note: 'CURRENT movie feature values only.'
}

// ---------------- RELATIONSHIPS ----------------
// Business: each user has exactly 1 occupation; an occupation has 0..N users
Ref: hw2_users.occupation_id > hw2_occupations.occupation_id

// movie_genres: a movie has 1..N genres (>=1), a genre has 0..N movies
Ref: hw2_movie_genres.movie_id > hw2_movies.movie_id
Ref: hw2_movie_genres.genre_id > hw2_genres.genre_id

// ratings: a user has 0..N ratings, a movie has 0..N ratings; each rating has exactly 1 user and 1 movie
Ref: hw2_ratings.user_id > hw2_users.user_id
Ref: hw2_ratings.movie_id > hw2_movies.movie_id

// Offline: a user/movie has 0..N feature versions; each version belongs to exactly 1 entity
Ref: hw2_offline_user_features_hist.user_id > hw2_users.user_id
Ref: hw2_offline_movie_features_hist.movie_id > hw2_movies.movie_id

// training_events: 1 rating <-> 0..1 event; each event has exactly 1 rating
Ref: hw2_training_events.(user_id, movie_id) - hw2_ratings.(user_id, movie_id)

// Online: a user/movie has 0..1 online record; each record belongs to exactly 1 entity
Ref: hw2_online_user_features.user_id - hw2_users.user_id
Ref: hw2_online_movie_features.movie_id - hw2_movies.movie_id

// Lineage: an online record originates from exactly one offline history version
Ref: hw2_online_user_features.(user_id, source_valid_from) > hw2_offline_user_features_hist.(user_id, valid_from)
Ref: hw2_online_movie_features.(movie_id, source_valid_from) > hw2_offline_movie_features_hist.(movie_id, valid_from)

// ---------------- LAYER GROUPS ----------------
TableGroup business_layer {
  hw2_occupations
  hw2_users
  hw2_genres
  hw2_movies
  hw2_movie_genres
  hw2_ratings
}

TableGroup offline_feature_store {
  hw2_offline_user_features_hist
  hw2_offline_movie_features_hist
  hw2_training_events
}

TableGroup online_feature_store {
  hw2_online_user_features
  hw2_online_movie_features
}
